# PostgreSQL connection. Never commit a real password.
DATABASE_URL=postgresql://siren_user:replace_with_strong_password@localhost:5432/siren

# API security and browser origin
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
# Use a different long random secret for refresh JWTs. This limits the impact
# of a key compromise and keeps refresh tokens separate from access tokens.
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_at_least_32_characters
FRONTEND_URL=http://localhost:3000
PORT=4000

# Payme Business. Obtain these from the Payme Business cabinet; never commit live keys.
# Set PAYME_TEST_MODE=true while validating with Payme's test environment.
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_MODE=true
# Optional overrides. In production set this to your public HTTPS profile URL.
PAYME_RETURN_URL=http://localhost:3000/profile
# Public API base used to show the secure Payme callback URL in Admin → Settings.
PUBLIC_API_URL=http://localhost:4000
# PAYME_CHECKOUT_URL=https://test.paycom.uz

# Telegram notifications. Keep live bot tokens only in the untracked .env file.
TELEGRAM_ORDERS_BOT_TOKEN=replace_with_orders_bot_token
TELEGRAM_ORDERS_CHAT_ID=replace_with_orders_group_chat_id

TELEGRAM_CONTROL_BOT_TOKEN=replace_with_control_bot_token
TELEGRAM_CONTROL_CHAT_ID=replace_with_control_group_chat_id

# The first administrator is created only when no users exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_initial_password

# Transactional email: configure a verified SMTP sender before enabling OTP.
# Do not commit real SMTP credentials or Gmail app passwords.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace_with_smtp_user
SMTP_PASSWORD=replace_with_smtp_password
EMAIL_FROM=SIREN <sirencloths@gmail.com>
